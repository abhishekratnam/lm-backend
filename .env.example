# ── Option A: OpenCode gateway ─────────────────────────────────────────────
# Get a key at https://opencode.ai/console (personal API key or service account key).
# Two billing endpoints — use the one matching your plan:
#   Go subscription:  https://opencode.ai/inference/go/openai/v1     (covered by your plan)
#   Pay-as-you-go:    https://opencode.ai/inference/openai/v1        (billed from Console credits)
# "-free" models only work from inside OpenCode itself; external apps get
# HTTP 403 even with a key.
LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_MAX_TOOL_ROUNDS=6

# ── Option B: any other OpenAI-compatible endpoint (uncomment to use) ──────
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_MAX_TOOL_ROUNDS=6

# Hasura (host-side values; inside docker compose the app uses http://hasura:8080/v1/graphql)
HASURA_URL=http://localhost:8080/v1/graphql
HASURA_ADMIN_SECRET=myadminsecret
